# Gintanao mobile — environment variables
#
# COMMITTED template. Copy it to .env.local (git-ignored) and fill it in.
# EXPO_PUBLIC_* values are inlined into the app bundle when Metro builds it,
# so restart `npx expo start` after changing one. They are readable by anyone
# who installs the app: never put a secret here (that includes the backend's
# API_KEY).

# Base URL of the Laravel API, as reached FROM THE PHONE. Required.
# `localhost` on a phone or emulator is the device itself, not your PC:
#   • physical phone / any emulator:  http://<your PC's LAN IP>:8000/api
#       (start the backend with `php artisan serve --host=0.0.0.0 --port=8000`)
#   • Android emulator only:          http://10.0.2.2:8000/api
#   • iOS simulator only:             http://localhost:8000/api
#   • production:                     https://<api host>/api
EXPO_PUBLIC_API_BASE_URL=

# The web portal, used for share links and the pages the app opens in a browser
# (loan calculator, privacy, terms, accessibility).
EXPO_PUBLIC_SITE_URL=http://localhost:3000

# The backend's public origin: "Join as an agent", "Register your realty" and
# "Agent sign in" open its /register, /apply and /login.
EXPO_PUBLIC_DASHBOARD_URL=http://localhost:8000
